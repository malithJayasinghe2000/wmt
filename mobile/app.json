{
  "expo": {
    "name": "Clinic Appointments",
    "slug": "clinic-appointments",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sliit.clinicappointments"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow the app to pick a photo for your profile."
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
